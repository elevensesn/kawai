local function resolveIcon(name)
	for _, alias in ipairs(ALIASES[name] or { name }) do
		if FtIcons and FtIcons.Icon then
			local ok, data = pcall(FtIcons.Icon, alias)
			if ok and data then
				if type(data) == "string" then
					return { Image = data }
				elseif type(data) == "table" then
					local image = data[1] or data.Image or data.id
					local info = type(data[2]) == "table" and data[2] or data
					if image then
						if type(image) == "number" then
							image = "rbxassetid://" .. image
						end
						return {
							Image = image,
							Offset = info.ImageRectPosition or info.ImageRectOffset or info.imageRectOffset,
							Size = info.ImageRectSize or info.imageRectSize,
						}
					end
				end
			end
		end
		if RayIcons then
			local ok, entry = pcall(function() return RayIcons["48px"][alias] end)
			if ok and type(entry) == "table" and entry[1] and entry[2] and entry[3] then
				return {
					Image = "rbxassetid://" .. entry[1],
					Size = Vector2.new(entry[2][1], entry[2][2]),
					Offset = Vector2.new(entry[3][1], entry[3][2]),
				}
			end
		end
	end
end

local function makeIcon(parent, name, size, color, pos, anchor)
	local img = new("ImageLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(size, size),
		Position = pos or UDim2.new(),
		AnchorPoint = anchor or Vector2.new(),
		ImageColor3 = color or C.Text,
	}, parent)

	local data = resolveIcon(name)
	if data then
		img.Image = data.Image
		if data.Offset then img.ImageRectOffset = data.Offset end
		if data.Size then img.ImageRectSize = data.Size end
	else
		new("TextLabel", {
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Font = Enum.Font.GothamBold,
			Text = FALLBACK[name] or "?",
			TextColor3 = color or C.Text,
			TextSize = math.max(10, size - 4),
		}, img)
	end

	return img
end

local function makeDraggable(handle, target)
	local dragging, dragStart, startPos
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = target.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			target.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
end

