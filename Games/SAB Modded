local adminEvent = nil
task.spawn(function()
    local success, result = pcall(function()
        return ReplicatedStorage:WaitForChild("Packages"):WaitForChild("Net"):WaitForChild("RE/AdminPanelService/ExecuteCommand")
    end)
    if success then
        adminEvent = result
    end
end)

spamBtn.MouseButton1Click:Connect(function()
    if not selectedPlayer then return end
    
    isSpamming = not isSpamming
    
    if isSpamming then
        spamBtn.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
        spamTask = task.spawn(function()
            local commands = {"ragdoll", "rocket", "balloon", "inverse", "jail", "tiny", "jumpscare", "morph"}
            while isSpamming do
                if not gui.Parent then
                    isSpamming = false
                    break
                end
                
                if adminEvent and selectedPlayer and selectedPlayer.Parent then
                    for _, cmd in ipairs(commands) do
                        pcall(function()
                            adminEvent:FireServer(selectedPlayer, cmd)
                        end)
                    end
                else
                    isSpamming = false
                    if spamBtn and spamBtn.Parent then
                        spamBtn.BackgroundColor3 = Color3.fromRGB(135, 206, 250)
                    end
                end
                task.wait(0.1)
            end
        end)
    else
        if spamBtn and spamBtn.Parent then
            spamBtn.BackgroundColor3 = Color3.fromRGB(135, 206, 250)
        end
        if spamTask then
            task.cancel(spamTask)
            spamTask = nil
        end
    end
end)
